---
import { getCollection } from 'astro:content';
import App from '../layouts/App.astro';
import { isPost, sortNewestFirst } from '../lib/posts';

const posts = sortNewestFirst((await getCollection('posts')).filter(isPost));
---

<App title="Charlie Harrington" description="Charlie Harrington - Software Engineer and Writer">
  <ul>
    {posts.map((post) => (
      <li><a href={`/${post.id}`}>{post.data.title}</a>: {post.data.date}</li>
    ))}
  </ul>
</App>
