---
import App from '../layouts/App.astro';
---

<App title="Not Found" description="Page not found" slug="404">
  <h1 class="post-title">404: no such file or directory</h1>
  <div class="borderLine"></div>
  <p>
    This window opened onto nothing. The page you asked for isn't here — it may
    have been renamed, or it may never have existed in the first place.
  </p>
  <p><a href="/">Back to the desktop</a></p>
</App>
