        <rect x="99" y="107" width="7" height="6" rx="2" fill="#b8860b" />
      </g>

      <!-- Drawn around its middle: it goes wherever the hand holding it goes. -->
      <g id="inst-tambourine">
        <circle filter={F} r="17" fill="#f6efe2" />
        <circle filter={F} r="18" fill="none" stroke="#d9a066" stroke-width="6" />
        <g filter={F} fill="#e8b830">{jingles.map((j) => <ellipse cx={j.x} cy={j.y} rx="4.5" ry="3" transform={`rotate(${j.a + 90} ${j.x} ${j.y})`} />)}</g>
      </g>

      <!-- Origin-drawn: xylophone, cajón and pedal steel sit in front of the player. -->
      <g id="inst-xylophone">
        <g stroke="#5a3a22" stroke-width="4" stroke-linecap="round" filter={F}>
