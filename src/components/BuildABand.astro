    width: 0;
    height: 0;
    overflow: hidden;
  }

  .bab-stage {
    --c: var(--paper);
    position: relative;
    padding: 1rem 0.75rem 0.5rem;
    overflow: hidden;
  }

  /* A slab of orange clay for them to stand on. */
  .bab-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: var(--clay-texture) 0 0 / 240px, var(--orange);
    background-blend-mode: soft-light, normal;
    box-shadow: inset 0 6px 0 rgba(255, 255, 255, 0.2), inset 0 10px 14px rgba(0, 0, 0, 0.12);
    border-radius: 40% 40% 0 0 / 22px 22px 0 0;
  }

  .bab-band li {
    margin: 0;
    font-size: 1rem;
  }

  .bab-band {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.25rem;
