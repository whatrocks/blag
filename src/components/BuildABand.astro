        <ellipse cx="114" cy="209" rx="10" ry="4" fill="#7a5410" />
        <g filter={F} fill="#f6e6b0">{[[86, 152], [84, 166], [83, 180], [81, 194], [80, 208]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="4" />)}</g>
      </g>

      <g id="inst-trumpet" transform="rotate(-12 102 110) translate(102 110) scale(1.25) translate(-102 -110)">
        <rect filter={F} x="112" y="112" width="44" height="13" rx="6.5" fill="none" stroke="#e0b030" stroke-width="4" />
        <line filter={F} x1="104" y1="110" x2="160" y2="110" stroke="#e0b030" stroke-width="6" stroke-linecap="round" />
        <path filter={F} d="M156 106 C166 105 175 99 186 93 L186 127 C175 121 166 115 156 114 Z" fill="#e0b030" />
        <ellipse cx="186" cy="110" rx="3" ry="17" fill="#b8860b" />
