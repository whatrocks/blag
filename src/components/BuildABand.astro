        <g filter={F} fill="#7a4a2a">
          <rect x="-84" y="-12" width="168" height="5" rx="2" />
          <rect x="-84" y="10" width="168" height="5" rx="2" />
        </g>
        <g filter={F}>{xyloBars.map((b) => <rect x={b.x} y={b.y} width="13" height={b.h} rx="3" fill={b.fill} />)}</g>
        <g fill="#f6efe2">{xyloBars.map((b) => <circle cx={b.x + 6.5} cy={b.y + 4} r="1.4" />)}</g>
      </g>

      <g id="inst-cajon">
        <rect filter={F} x="-34" y="-46" width="68" height="92" rx="5" fill="#c98a5a" />
        <rect filter={F} x="-29" y="-41" width="58" height="82" rx="3" fill="#e6b680" />
        <g fill="#7a4a2a">{[[-25, -37], [25, -37], [-25, 37], [25, 37]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="1.8" />)}</g>
      </g>

      <g id="inst-pedalsteel">
        <g stroke="#4a4a4a" stroke-width="4" stroke-linecap="round" filter={F}>
          <path d="M-70 8 L-70 96 M70 8 L70 96" fill="none" />
        </g>
        <rect filter={F} x="-32" y="86" width="64" height="7" rx="3" fill="#4a4a4a" />
        <g filter={F} fill="#c8c8c8">{[-24, -7, 10].map((x) => <rect x={x} y="78" width="12" height="9" rx="2" />)}</g>
        <rect filter={F} x="-88" y="-11" width="176" height="22" rx="6" fill="#2e4a6a" />
        <rect x="-62" y="-6" width="124" height="9" rx="2" fill="#f6efe2" />
        <g stroke="#7a4a2a" stroke-width="0.8">{Array.from({ length: 15 }, (_, i) => <line x1={-58 + i * 8} y1="-6" x2={-58 + i * 8} y2="3" />)}</g>
        <rect x="-78" y="-6" width="9" height="9" rx="2" fill="#1e1410" />
        <g stroke="#fff" stroke-width="0.5" opacity="0.8">{[-4.5, -2.5, -0.5, 1.5].map((y) => <line x1="-84" y1={y} x2="84" y2={y} />)}</g>
      </g>

      <!-- Drawn where they sit on a bandmate: upright bass, theremin and viola. -->
      <g id="inst-upright">
        <line x1="58" y1="286" x2="58" y2="302" stroke="#9a9a9a" stroke-width="3" stroke-linecap="round" />
        <line filter={F} x1="60" y1="190" x2="70" y2="58" stroke="#8a4a1e" stroke-width="10" stroke-linecap="round" />
        <path filter={F} d="M58 170 C76 170 86 182 84 198 C83 208 78 214 78 222 C78 230 92 238 92 256 C92 276 76 288 56 288 C36 288 20 276 20 256 C20 238 36 230 36 222 C36 214 30 208 30 198 C30 182 40 170 58 170 Z" fill="#8a4a1e" />
        <path d="M44 216 q4 6 0 12 q-4 6 0 12 M72 216 q4 6 0 12 q-4 6 0 12" fill="none" stroke="#3a1a08" stroke-width="2" stroke-linecap="round" />
        <line x1="59" y1="280" x2="59" y2="246" stroke="#1e1410" stroke-width="8" stroke-linecap="round" />
        <rect x="47" y="234" width="24" height="5" rx="2" fill="#e6b680" />
        <line filter={F} x1="61" y1="236" x2="70" y2="62" stroke="#1e1410" stroke-width="8" stroke-linecap="round" />
        <circle filter={F} cx="71" cy="51" r="7" fill="#8a4a1e" />
        <g stroke="#f6efe2" stroke-width="0.7" opacity="0.8">
          <line x1="56" y1="276" x2="68" y2="62" />
          <line x1="59" y1="276" x2="70" y2="62" />
          <line x1="62" y1="276" x2="72" y2="62" />
        </g>
      </g>

      <g id="inst-theremin">
        <g stroke="#4a4a4a" stroke-width="3" stroke-linecap="round">
          <path d="M70 206 L60 302 M110 206 L120 302 M90 206 L90 302" fill="none" />
        </g>
        <path d="M44 194 C30 194 22 188 22 181 C22 172 34 170 46 178" fill="none" stroke="#c8c8c8" stroke-width="3" stroke-linecap="round" />
