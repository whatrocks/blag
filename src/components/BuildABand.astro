    text-transform: uppercase;
    cursor: pointer;
    transform: translateY(var(--press)) scale(var(--squash, 1), calc(2 - var(--squash, 1)));
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .clay-button:hover,
  .clay-button:focus-visible {
    --press: 3px;
    --squash: 1.03;
  }

  .clay-button:active {
    --press: var(--lift);
    --squash: 1.07;
  }

  button:focus-visible {
    outline: 3px solid var(--teal);
